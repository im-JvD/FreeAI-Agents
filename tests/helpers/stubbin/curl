#!/usr/bin/env bash
#-------------------------------------------------------------------------------
# Test stub: curl
#
#   * every call to the mock OmniRoute server (127.0.0.1:$MOCK_OMNI_PORT) is
#     handed to the real curl - the mock is a real HTTP server on purpose, so
#     the cookie jar / JSON handling of the script is exercised for real.
#   * provider key-verification endpoints answer with KEYCHECK_CODE (200).
#   * a call made through -x <proxy> answers with PROXY_CALL_CODE when set
#     (used to simulate a reachable Windows proxy).
#   * anything else using -w '%{http_code}' (the LiteLLM health check and the
#     doctor live test) answers with HEALTH_CODE (200).
#   * a download of setup.sh is served from FAKE_SELF_SOURCE when set (used by
#     the update / self-heal tests).
#-------------------------------------------------------------------------------
LOG="${T_WORKSTATE:-/tmp}/curl-calls.log"
[ -n "${T_WORKSTATE:-}" ] && printf 'curl %s\n' "$*" >> "$LOG"

MOCK_PORT="${MOCK_OMNI_PORT:-20871}"

for a in "$@"; do
  case "$a" in
    "http://127.0.0.1:${MOCK_PORT}"*|"http://localhost:${MOCK_PORT}"*)
      exec /usr/bin/curl "$@"
      ;;
  esac
done

# serve the script itself for update / self-heal tests
if [ -n "${FAKE_SELF_SOURCE:-}" ] && [ -f "${FAKE_SELF_SOURCE}" ]; then
  for a in "$@"; do
    case "$a" in
      *setup.sh*)
        target=""
        prev=""
        for a2 in "$@"; do
          if [ "$prev" = "-o" ]; then target="$a2"; fi
          prev="$a2"
        done
        if [ -n "$target" ]; then
          cat "$FAKE_SELF_SOURCE" > "$target"
        else
          cat "$FAKE_SELF_SOURCE"
        fi
        exit 0
        ;;
    esac
  done
fi

is_proxied=0
for a in "$@"; do
  case "$a" in
    -x) is_proxied=1 ;;
  esac
done

for a in "$@"; do
  case "$a" in
    *api.groq.com*|*openrouter.ai*|*generativelanguage.googleapis.com*|*api.cerebras.ai*|*api.mistral.ai*|*models.inference.ai.azure.com*|*api.sambanova.ai*|*integrate.api.nvidia.com*|*api.together.xyz*)
      if [ "$is_proxied" -eq 1 ] && [ -n "${PROXY_CALL_CODE:-}" ]; then
        printf '%s' "$PROXY_CALL_CODE"
        exit 0
      fi
      printf '%s' "${KEYCHECK_CODE:-200}"
      exit 0
      ;;
  esac
done

# /v1/models list for the doctor command (must contain the branded model id)
for a in "$@"; do
  case "$a" in
    http://127.0.0.1:4000/v1/models)
      echo '{"data":[{"id":"claude-freeagents","object":"model"}]}'
      exit 0
      ;;
  esac
done

code="${HEALTH_CODE:-200}"
if [ "$is_proxied" -eq 1 ] && [ -n "${PROXY_CALL_CODE:-}" ]; then
  printf '%s' "$PROXY_CALL_CODE"
  exit 0
fi
for a in "$@"; do
  case "$a" in
    *%{http_code}*)
      printf '%s' "$code"
      exit 0
      ;;
  esac
done
exit 0
