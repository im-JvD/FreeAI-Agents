#!/usr/bin/env bash
#-------------------------------------------------------------------------------
# Test stub: curl
#
# - Provider key-verification endpoints (groq/openrouter/google/cerebras/
#   mistral) answer with KEYCHECK_CODE (default: 200).
# - Anything else using -w '%{http_code}' (the health check) answers with
#   HEALTH_CODE (default: 200).
#-------------------------------------------------------------------------------
# Serve a fake secondary-engine installer when the tests provide one
# (honours curl's -o <file> so the caller's output file is really written)
if [ -n "${FAKE_OMNI_SCRIPT:-}" ] && [ -f "${FAKE_OMNI_SCRIPT}" ]; then
  for a in "$@"; do
    case "$a" in
      *OmniRoute-OpenCode*)
        prev=""
        for a2 in "$@"; do
          if [ "$prev" = "-o" ]; then
            cat "${FAKE_OMNI_SCRIPT}" > "$a2"
            exit 0
          fi
          prev="$a2"
        done
        cat "${FAKE_OMNI_SCRIPT}"
        exit 0
        ;;
    esac
  done
fi
is_proxied=0
for a in "$@"; do
  case "$a" in
    -x) is_proxied=1 ;;
  esac
done
for a in "$@"; do
  case "$a" in
    *api.groq.com*|*openrouter.ai*|*generativelanguage.googleapis.com*|*api.cerebras.ai*|*api.mistral.ai*)
      # a call explicitly routed through -x simulates the installer's proxy
      # test call (PROXY_CALL_CODE lets tests fail it on purpose)
      if [ "$is_proxied" -eq 1 ] && [ -n "${PROXY_CALL_CODE:-}" ]; then
        printf '%s' "$PROXY_CALL_CODE"
        exit 0
      fi
      printf '%s' "${KEYCHECK_CODE:-200}"
      exit 0
      ;;
  esac
done
# /v1/models list for the doctor command (2 Groq models, matching the
# groq-only install used in the offline tests)
for a in "$@"; do
  case "$a" in
    http://127.0.0.1:4000/v1/models)
      echo '{"data":[{"id":"claude-gpt-oss-120b","object":"model"},{"id":"claude-gpt-oss-20b","object":"model"}]}'
      exit 0
      ;;
  esac
done
# chat completions (doctor live test): falls through to the generic
# '%{http_code}' handler below (prints HEALTH_CODE, default 200).
code="${HEALTH_CODE:-200}"
if [ "$is_proxied" -eq 1 ] && [ -n "${PROXY_CALL_CODE:-}" ]; then
  printf '%s' "$PROXY_CALL_CODE"
  exit 0
fi
for a in "$@"; do
  case "$a" in
    *%{http_code}*)
      printf '%s' "$code"
      exit 0
      ;;
  esac
done
exit 0
